package waos:files;

/// What a program's `std` imports for its files on `wasm32-wasip2`, which WaOS serves itself
/// (`crates/waos/src/files`): `wasi:filesystem` 0.2's descriptors and its preopened folders.
world files {
  import wasi:filesystem/types@0.2.12;
  import wasi:filesystem/preopens@0.2.12;
}
