package wasdk:platform@0.1.0;

/// The system's check of a server's certificate, for a program that brings its own TLS: one
/// answering as this system answers, with its roots, those the user or an organization added,
/// revocation and its own rules, so a program trusts what the machine's own apps trust. HTTP
/// through `wasi:http` needs none of this: WaOS checks its servers the same way.
interface trust {
  /// Why a chain is not trusted, in the system's words.
  variant trust-error {
    /// The system does not trust the chain for that server: an unknown issuer, a name it is not
    /// for, an expired or revoked certificate.
    untrusted(string),
    /// The check could not be made: a chain that is no certificate, a server name that is none,
    /// or the system failing to answer.
    failed(string),
  }

  /// The system's checker.
  resource trust {
    /// Checks a server's certificate chain, leaf first, as this system checks it: its roots,
    /// those the user or an organization added, revocation and the system's own rules.
    verify-server: async func(chain: list<list<u8>>, server-name: string) -> result<_, trust-error>;
  }

  /// The system's checker, where the system has one.
  get-trust: func() -> option<trust>;
}
