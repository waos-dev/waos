package wasdk:platform@2.2.0;

/// Memory the system shares with the program's GPU device, as each system's GPU API imports it:
/// Metal's `newTextureWithDescriptor:iosurface:plane:` over an `IOSurface`, Vulkan's external
/// memory over an `AHardwareBuffer` or a dmabuf, D3D's `OpenSharedResource` over a shared
/// texture. A hardware buffer names no GPU API (`hardware-buffers`); this is where it meets the
/// program's device (`wasdk:gpu`), so it is named as Vulkan, CUDA and Android name sharing with a
/// GPU API, interop, and a fence or a semaphore shared later belongs here too.
interface gpu-interop {
  use wasdk:gpu/gpu@1.0.0.{device, texture};
  use wasdk:gpu/types@1.0.0.{texture-aspect};
  use hardware-buffers.{hardware-buffer};

  /// A texture on `device` over `buffer`'s memory, of the buffer's size and format, for what its
  /// usage names, `gpu-sampled` as a texture's `texture-binding` and `gpu-color-output` as its
  /// `render-attachment` and `copy-dst`, and copied from whatever its usage. It holds the buffer,
  /// and a video frame's buffer the frame, until the GPU is done with it. The planes of a buffer
  /// of more than one are `import-planes`'.
  import-texture: func(device: borrow<device>, buffer: borrow<hardware-buffer>) -> texture;

  /// Each plane of `buffer`'s memory on `device`, sampled and copied from, in the order of a
  /// video frame's planes (`wasdk:media/video-frames`). Where the device has the buffer's
  /// two-plane format (`nv12`, `p010`; D3D12 and Vulkan), every plane is the one texture in that
  /// format with the plane's aspect, `plane0` then `plane1`; elsewhere (Metal) each plane is a
  /// texture of its own, `r8-unorm` and `rg8-unorm` or their 16-bit kinds, with the aspect `all`.
  /// A view of a plane takes its aspect, and a binding or an external texture takes the views. A
  /// buffer of one plane answers its one texture, with `all`. Each texture holds the buffer, and
  /// the frame, as `import-texture`'s does.
  import-planes: func(device: borrow<device>, buffer: borrow<hardware-buffer>) -> list<texture-plane>;

  /// One plane of a hardware buffer as the GPU reads it: the texture, and the aspect of it
  /// that is the plane.
  record texture-plane {
    texture: texture,
    aspect: texture-aspect,
  }
}
