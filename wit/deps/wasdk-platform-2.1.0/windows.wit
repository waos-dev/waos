package wasdk:platform@2.1.0;

/// What only a desktop can do with a view: put a frame around it, a title on it, a place on
/// screen, and limits on the size its user resizes it to; move it from a press, maximize it and
/// minimize it, for a program that draws its own title bar. A window is what a desktop's shell,
/// or Android's, shows a view in. A program reaches a window from its view (`view.window` in `views`), and
/// asks for one with `views.request-view`, whose `window-config` says how the window is made. A
/// view in a phone's tab has no window: its `window` answers none, and the shell refuses requests.
///
/// Sizes and positions are in logical points from the top-left of the main screen, y down: the
/// coordinates a screen's frame is in (`screen.frame` in `screens`).
interface windows {
  resource window {
    /// Where the window is on the desktop, in those coordinates.
    frame: func() -> rect;
    /// Moves and sizes the window, over `animate` nanoseconds where the platform can
    /// animate a frame, at once elsewhere.
    set-frame: func(frame: rect, animate: option<u64>);

    set-title: func(title: string);

    show: func();
    hide: func();
    /// Closes the window; its view goes away with it, its events end, and `removed` arrives on
    /// `views.view-changes`. The user's requests to close the window arrive among its view's
    /// events, and this is how a program agrees to one.
    close: func();
    /// The smallest and largest size the user may resize the window to; none where users do
    /// not resize windows. The same answer for as long as the window is open.
    size-limits: func() -> option<size-limits>;
    /// Starts the system's own move of the window from the press under way, as a press on its
    /// title bar does: for a program that draws its own. Called from the press; outside one it
    /// does nothing.
    drag: func();
    /// Whether the window is maximized: Flutter's `WindowController.isMaximized`; on macOS,
    /// zoomed.
    is-maximized: func() -> bool;
    /// Maximizes the window, or returns it to its size from before; on macOS, zooms it.
    set-maximized: func(maximized: bool);
    /// Minimizes the window, or restores it: Flutter's `WindowController.setMinimized`.
    set-minimized: func(minimized: bool);
    /// What the system's settings say a double-click on a title bar does, for a program that
    /// draws its own: macOS's "Double-click a window's title bar to". None where the system has
    /// no such setting.
    title-bar-double-click-action: func() -> option<title-bar-action>;
  }

  /// What a double-click on a window's title bar does.
  enum title-bar-action {
    maximize,
    minimize,
    nothing,
  }

  /// The limits a window its user resizes keeps its content within: the view's size, without
  /// the system's title bar and border, in logical points. A limit holds until it is set
  /// again, and none takes it away. Flutter's window constraints, the minimum and the maximum
  /// apart.
  resource size-limits {
    /// The smallest size the user may resize the window to; none for no minimum.
    set-min-size: func(size: option<size>);
    /// The largest size the user may resize the window to; none for no maximum.
    set-max-size: func(size: option<size>);
  }

  /// How a window is made: what `views.request-view` takes. New, it describes the platform's
  /// ordinary window, and each setter changes one option, so a program sets only what it wants
  /// otherwise. Every option names what the window is for, not how a system does it: the
  /// platform maps each onto what its system has, and one its system lacks it leaves at the
  /// system's default.
  resource window-config {
    /// The platform's ordinary window: no title; the size and the place the platform chooses;
    /// the system's decorations; resizable; at the normal level; activating; on one desktop;
    /// a solid background; the system's shadow; visible; on macOS, the system's title bar.
    constructor();

    /// Empty unless set.
    set-title: func(title: string);
    /// The platform's default size unless set.
    set-size: func(size: size);
    /// Where the window opens; the platform chooses unless set.
    set-position: func(position: point);
    /// The system's title bar and border. On unless set.
    set-decorations: func(decorations: bool);
    /// On unless set.
    set-resizable: func(resizable: bool);
    /// `normal` unless set.
    set-level: func(level: window-level);
    /// Whether showing or clicking the window makes it the focused one. On unless set. A
    /// platform may not be able to refuse activation.
    set-activating: func(activating: bool);
    /// Whether the window is on every virtual desktop: macOS Spaces, X11 workspaces. Off
    /// unless set.
    set-all-desktops: func(all-desktops: bool);
    /// `solid` unless set.
    set-background: func(background: window-background);
    /// Whether the window casts the system's shadow. On unless set.
    set-shadow: func(shadow: bool);
    /// On unless set.
    set-visible: func(visible: bool);
    /// macOS only: the window's title bar, `standard` unless set. Other systems leave it out.
    set-macos-title-bar: func(title-bar: macos-title-bar);
  }

  /// The title bar of a macOS window.
  variant macos-title-bar {
    /// The system's, with the window's title in it.
    standard,
    /// None of its own, as in Safari and Finder: the view runs to the window's top edge, and
    /// the close, minimize and zoom buttons sit over it, centred in a band at the top this many
    /// logical points tall. Presses in the band reach the program, which moves the window
    /// (`window.drag`) and does what a double-click on a title bar does
    /// (`window.title-bar-double-click-action`).
    hidden(f64),
  }

  record point {
    x: f64,
    y: f64,
  }

  record size {
    width: f64,
    height: f64,
  }

  record rect {
    origin: point,
    size: size,
  }

  enum window-level {
    normal,
    /// Above ordinary windows, as a palette or a panel sits.
    always-on-top,
    /// Below ordinary windows, as a desktop widget sits.
    always-on-bottom,
  }

  /// What the window shows behind the program's painting. Anything but `solid` lets what
  /// is behind the window show where the program paints nothing.
  enum window-background {
    solid,
    transparent,
    /// The system's blur of what lies behind the window.
    blurred,
    /// The system's glass material, or its blur where it has none.
    glass,
  }
}
