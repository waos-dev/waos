package wasdk:platform@1.0.0;

/// The screens the system shows views on: each monitor, with where it is on the desktop, its
/// size, scale and refresh rate.
///
/// A monitor is a screen, as Apple names it. A system has one or several, and each has its own
/// place on the desktop, size, scale and refresh rate; a view is on one of them (`view.screen` in
/// `views`), and may move to another. The list changes when the user plugs a monitor in or out,
/// and a screen changes when the user sets its resolution or its refresh rate, arranges the
/// screens, or moves or hides the Dock or the taskbar.
interface screens {
  use windows.{rect};

  /// Names a screen for as long as the system has it; a screen that comes back after being
  /// unplugged may have a new id.
  type screen-id = u64;

  /// A size in physical pixels.
  record pixel-size {
    width: u32,
    height: u32,
  }

  resource screen {
    id: func() -> screen-id;

    /// The name the system shows for it, for a program that lets its user choose a screen:
    /// `Built-in Retina Display`. Empty where the system has none.
    name: func() -> string;

    /// Its size now, in physical pixels.
    size: func() -> pixel-size;

    /// Physical pixels per logical pixel on it now.
    scale: func() -> f64;

    /// How often it refreshes now, in millihertz: 60 000 for 60 Hz. 0 where the system does
    /// not say.
    refresh-rate: func() -> u32;

    /// Where the screen is on the desktop, in logical points from the top-left of the main
    /// screen, y down: the coordinates a window's frame is in.
    frame: func() -> rect;

    /// What the system's own bars leave free (the menu bar and the Dock, or the taskbar), in the
    /// same coordinates; the whole frame where the system cannot say.
    visible-frame: func() -> rect;
  }

  /// A change to the screens, in the order the changes happened.
  variant screen-change {
    /// A screen the system now has.
    added(screen),
    /// A screen the system no longer has; the handles the program holds on it go on
    /// answering what it was.
    removed(screen-id),
    /// A screen whose size, scale, refresh rate, frame or visible frame changed: read it again.
    changed(screen-id),
  }

  /// The screens the system has now.
  screens: func() -> list<screen>;

  /// What changes among the screens from now on. Each call is a stream of its own.
  screen-changes: func() -> stream<screen-change>;
}
