package wasdk:platform@0.1.0;

/// The machines the program acts on as their user: this computer, and SSH machines once WaOS can
/// reach them. A machine gives its files from its root and runs commands, with pipes or in a
/// terminal, as one SSH login gives files, `exec` and a terminal.
///
/// **A machine is the user's to give.** The program gets one the way an app gets a photo through
/// the system's picker: it asks (`pick`), WaOS shows the machines, and the one the user picks is
/// the program's from then on, until the user takes it back in the program's settings in WaOS. A
/// program lists only the machines picked for it (`granted`), never all the user's.
///
/// **What a machine runs runs outside the program's sandbox**, as the machine's user, with
/// everything that user can reach: a grant is all or nothing, as a login is. A command runs in the
/// user's login environment on the machine, its own variables on top.
///
/// A machine held stays the program's for the rest of its run, as an open file does, even once
/// the user takes it back; `granted` and the next run follow the user.
interface machines {
  use wasi:filesystem/types@0.3.0.{descriptor};

  /// What to run: a program, by its name on the machine's `PATH` or by its path, and its
  /// arguments, each passed as it is. A terminal's type is its `TERM` variable.
  resource command {
    constructor(program: string);
    add-argument: func(argument: string);
    /// The folder it starts in, a path from the machine's root, as `root` names it; the user's
    /// home folder unless set.
    working-directory: func(path: string);
    /// A variable, on top of the login environment; set again, the last value holds.
    variable: func(name: string, value: string);
  }

  /// A terminal's size in character cells, and in pixels where the program knows them, else 0.
  record terminal-size {
    columns: u16,
    rows: u16,
    width-in-pixels: u16,
    height-in-pixels: u16,
  }

  /// A signal for a started command and every process of its group.
  enum signal {
    /// `SIGHUP`, as if its terminal went away.
    hangup,
    /// `SIGINT`, what Ctrl-C sends: for a command run with pipes, which has no terminal to send
    /// it through.
    interrupt,
    /// `SIGTERM`: asked to end.
    terminate,
    /// `SIGKILL`: ended at once, for a command that ignores the others.
    kill,
  }

  /// How a started command ended.
  variant exit-status {
    /// It exited with this code.
    exited(u32),
    /// A signal ended it: the signal's name without `SIG`, as SSH names it, such as `TERM`.
    signaled(string),
    /// The machine never said.
    unknown,
  }

  /// Why a command did not run, or its input was not taken.
  variant exec-error {
    /// The machine would not run it: no such program, or not allowed.
    refused(string),
    /// The machine could not be reached, or failed while running it.
    failed(string),
  }

  /// A started command. Dropping it leaves the command running.
  resource child {
    /// Sends `signal` to the command's process group. A machine may not deliver it.
    signal: func(signal: signal);
    /// How the command ended, once it has. Every call answers the same. A command may not end
    /// until what it wrote has been read, so a program waiting for this reads its output
    /// meanwhile, or drops it.
    exit-status: async func() -> exit-status;
  }

  /// A command's input, output and errors, each a pipe of its own.
  resource pipes {
    /// Writes `data` to the command's input; resolves once the pipe has taken it.
    write: async func(data: list<u8>) -> result<_, exec-error>;
    /// Closes the command's input, which it then reads to its end.
    close-input: func();
    /// What the command writes to its output, from its start. There is one reader: the first
    /// call takes the stream, and a later one answers none. While nobody reads it the command
    /// waits; dropping it throws away what follows.
    output: func() -> option<stream<u8>>;
    /// What the command writes to its errors, as `output` is.
    errors: func() -> option<stream<u8>>;
  }

  /// One terminal that is a command's input, output and errors together. Dropping it closes the
  /// terminal, which hangs the command up.
  resource terminal {
    /// Writes `data` to the terminal, as typed; resolves once the terminal has taken it. Keys that
    /// signal the foreground job, such as Ctrl-C, are bytes like any other.
    write: async func(data: list<u8>) -> result<_, exec-error>;
    /// Everything the command writes to its terminal, as `pipes.output` is.
    output: func() -> option<stream<u8>>;
    /// Tells the command the terminal's new size.
    resize: func(size: terminal-size);
  }

  /// One machine the program holds.
  resource machine {
    /// Its name, as the user knows it.
    name: func() -> string;
    /// Its files, from its root, `/`, whole. On Windows the root holds the drives, each by its
    /// letter: `C:\Users\me` is `/c/Users/me`, as MSYS2 and Git's shell name it.
    root: func() -> descriptor;
    /// Runs `command`, its input, output and errors each a pipe of its own.
    exec: async func(command: borrow<command>) -> result<tuple<child, pipes>, exec-error>;
    /// Runs `command` in a new terminal of `size`.
    exec-in-terminal: async func(command: borrow<command>, size: terminal-size) -> result<tuple<child, terminal>, exec-error>;
  }

  /// The machines the program may hold.
  resource machines {
    /// The machines the user picked for the program, kept until the user takes them back.
    granted: func() -> list<machine>;
    /// Asks the user to pick a machine for the program, and answers it; none when the user
    /// cancels, or WaOS has nobody to ask.
    pick: async func() -> option<machine>;
  }

  /// The machines, where the program may be given any.
  get-machines: func() -> option<machines>;
}
