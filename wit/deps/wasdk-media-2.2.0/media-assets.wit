package wasdk:media@2.2.0;

/// Media read by the system without playing it: a library's lengths, titles and thumbnails before
/// anything plays, as Apple's `AVAsset` and `AVAssetImageGenerator`, Android's
/// `MediaMetadataRetriever` and Windows' `MediaClip` read them, beside each system's player.
///
/// **Sources.** An asset is opened on a source as a player is (`media-players`): a path the program
/// can read, or an `http` or `https` link, which passes the program's network rules first. A source
/// the rules refuse, a path outside the program's files, and text that is neither give an asset
/// whose every answer is `refused`, and the system is handed none of them.
///
/// **Answers.** Each answer waits for the system to read what it asks, and is the player's type
/// for it: its tracks as a player lists them, each selected that a player would play unless asked
/// otherwise, its tags as a player's metadata, a failure of the player's kinds, and a picture as
/// the video's frame a frame reader hands out, which the program draws as it draws any.
interface media-assets {
  use wasi:clocks/types@0.3.0.{duration};
  use wasdk:platform/windows@2.2.0.{size};
  use media-players.{media-track, media-metadata, seek-tolerance, player-error};
  use video-frames.{video-frame};

  /// The system's reading of media without playing it; none where it has none.
  get-media-assets: func() -> option<media-assets>;

  resource media-assets {
    /// A file's path or a link, as a player opens one.
    open: func(source: string) -> media-asset;
  }

  resource media-asset {
    /// How long it is; none for a live stream, as a player's state has none.
    duration: async func() -> result<option<duration>, player-error>;
    tracks: async func() -> result<list<media-track>, player-error>;
    metadata: async func() -> result<media-metadata, player-error>;
    /// The frame at `time`, within `tolerance`, scaled to fit `max-size` where given.
    frame-at: async func(time: duration, tolerance: seek-tolerance, max-size: option<size>) -> result<video-frame, player-error>;
  }
}
