package wasdk:platform@2.2.0;

/// Where a program draws and where its input comes from.
///
/// A view is a rectangle of physical pixels the platform puts on screen: the whole screen
/// in a phone's tab, a window's contents in a window. A program has a view only by asking for one
/// with `request-view`, and hears of each on one stream, `view-changes`. The shell decides where
/// each goes: a window on a desktop, a task on Android, a tab inside WaOS. It may answer a request
/// with a screen it shows already, such as the one the user opened the program into, and the
/// program cannot tell that from a new window. A program that never asks has no view, which is
/// how a program with no window runs. `views` is what the program has now, which is none before it
/// asks. A view carries the id of the request it arrived for, and what the request attached as
/// `initial-data`.
///
/// Drawing is WebGPU's canvas model. A view hands out a `gpu-canvas-context`; the program
/// sets the size of the view's canvas, configures the context against its device, draws into
/// the texture the context gives for the current frame, and `present` puts that texture on
/// screen. The canvas is the size the program sets, whatever the view's size, so a program
/// sets it again as the view's `metrics` change. Frames are on demand: nothing
/// is drawn until the program asks with `request-frame`, and a view gets one `frame` event for
/// each refresh of the screen it is on: asked for before the view had the frame of the refresh
/// the screen is in, it arrives at once; asked for after, at the next refresh. A refresh that
/// comes serves every view of the program on that screen that waits for a frame: each gets the
/// frame on its own stream, and the frame names them all, so a program drawing several views at
/// once knows which frames belong together; a frame that arrives at once names its view alone.
///
/// What the system's compositor shows for the program, a player's video, a camera's preview or a
/// hardware buffer the program drew, is a `composition-layer` the program makes on the compositor,
/// where the system has one (`get-compositor`). A view holds the layers it shows beneath the
/// program's drawing, where the drawing leaves them clear, each with its placement, as `set-layers`
/// last set them, and its next present shows them with its picture; a layer the view no longer
/// holds is taken off with that picture, so the layers shown are always those set when the picture
/// on screen was presented. What a layer shows is apart from where it is: a buffer presented to it
/// shows from the compositor's next frame, wherever the layer is placed then.
///
/// Everything that happens to a view arrives on its one stream of events, in the order it
/// happened; what the user set that belongs to no one view is `system`'s, and the screens are
/// `screens`'.
///
/// What a desktop can do around a view of its own (a frame, a title, a place on screen) is
/// `windows`, reached from the view; closing is the window's.
///
/// Text is edited in Flutter's way: the program keeps the text, its selection and what is being
/// composed, and tells the view's `text-input` each change, so the platform's input methods
/// always have a copy to read and never wait on the program. Each edit an input method makes
/// arrives as the whole new value, among the view's events, in order with the keys. A key the
/// program does not handle is the program's to type. Offsets count UTF-16 code units.
///
/// The user's Back is answered in advance, as Android has an app register for it: a program says
/// whether it goes back within itself, and hears the press only while it does. The platform cannot
/// wait for a program, which runs behind the interface, to answer a press on the spot.
interface views {
  use wasi:webgpu/webgpu@0.3.0-rc.2.{gpu-canvas-context};
  use screens.{screen};
  use windows.{window, window-config, rect, size};
  use clipboard.{copy-request, paste};
  use hardware-buffers.{hardware-buffer};
  use system.{brightness};

  /// Nanoseconds on `wasi:clocks/monotonic-clock`, the clock behind the program's own
  /// monotonic time, so a stamp compares directly with what the program reads itself.
  type instant = u64;

  /// Names a view for the program's run: Flutter's `FlutterView.viewId`.
  type view-id = u64;

  /// Names one request made with `request-view`, so the program matches the view that arrives,
  /// or the failure, to what it asked for.
  type request-id = u64;

  variant view-error {
    /// The place the program runs in can show no other view, such as an app bundling one
    /// program with its one view.
    unsupported,
    failed(string),
  }

  /// A layer of the system's compositor that the program places beneath its drawing, where it
  /// leaves it clear: a player's video, a camera's preview, a hardware buffer the program drew.
  /// Made by the compositor; shown while a view's layers name it.
  ///
  /// It shows one source at a time, the last given it, as a player's picture goes to one
  /// destination at a time: the buffers the program presents to it, or a player's video or a
  /// camera's preview, given it as their output (`media-players`, `cameras`). A present takes the
  /// layer from the player or the camera that drew on it, whose picture goes nowhere until it is
  /// given a destination again; a player or a camera given the layer takes it from the buffers
  /// presented, each going back as `present` says.
  resource composition-layer {
    /// Shows `buffer` on the layer, filling it, in place of what the layer showed: Core
    /// Animation's `contents`, Android's `ASurfaceTransaction_setBuffer`. It shows from the
    /// compositor's next frame once the GPU has finished the work the program submitted and the
    /// writes it queued before this call, so the compositor never shows a picture half drawn, and
    /// the program goes on meanwhile. The layer holds the buffer while it shows it, whether or not
    /// the program does. The answer resolves once the compositor is done with the buffer, and the
    /// program may draw into it again unseen: after a later present or a player replaced it and
    /// the compositor stopped reading it, which Apple's systems learn only at the layer's next
    /// present, or once the layer is gone.
    ///
    /// So a program that shows a picture that changes never waits for a buffer to come back
    /// before it presents the next one: on Apple's systems the buffers it waits for come back
    /// only with a present, and once every buffer it has is out it would make none, and show the
    /// same picture from then on. At each picture it draws into a buffer that is back, or, when
    /// none is, into one more, which it allocates; a moment in which the compositor lets go late
    /// leaves it with more buffers than it needs after, which it drops.
    present: func(buffer: borrow<hardware-buffer>) -> future;
  }

  /// The system's compositor, which makes the layers a program places beneath its drawing.
  resource compositor {
    /// A layer placed nowhere yet, `opaque` when nothing beneath it will show through it.
    make-layer: func(opaque: bool) -> composition-layer;
  }

  /// The system's compositor, where it has one.
  get-compositor: func() -> option<compositor>;

  record placed-layer {
    layer: borrow<composition-layer>,
    placement: placement,
  }

  /// Where a layer sits: its rectangle, then what the program's containers above it do to it,
  /// the outermost first, in the coordinates the transforms before each lead to. The transforms
  /// together take the rectangle's coordinates to the view's physical pixels.
  ///
  /// A buffer presented to the layer is taken as drawn at the view's `device-pixel-ratio`: that
  /// many of its pixels lie along one unit of the rectangle's coordinates, as Flutter places a
  /// platform view. So a rectangle in logical pixels under a transform by the ratio shows a
  /// buffer of the rectangle's size in physical pixels one pixel to one, and a rectangle in
  /// physical pixels under no transform shows the same buffer smaller by the ratio.
  record placement {
    rect: rect,
    mutators: list<mutator>,
  }

  variant mutator {
    /// A 4×4 matrix, column-major.
    transform(list<f32>),
    clip-rect(rect),
    clip-rounded-rect(rounded-rect),
    /// The alpha it shows at, out of 255.
    opacity(u8),
  }

  /// A rectangle with each corner's radii, horizontal and vertical.
  record rounded-rect {
    rect: rect,
    top-left: size,
    top-right: size,
    bottom-right: size,
    bottom-left: size,
  }

  resource view {
    id: func() -> view-id;

    /// The request this view arrived for.
    request-id: func() -> request-id;

    /// What the request this view arrived for attached; none for a request that attached
    /// nothing.
    initial-data: func() -> option<string>;

    /// The window this view is in; none where the platform shows it without one.
    window: func() -> option<window>;

    /// The screen this view is on now; none while it is on no screen.
    screen: func() -> option<screen>;

    /// The WebGPU context that draws into this view.
    context: func() -> gpu-canvas-context;

    /// Sets the size of the textures the view's canvas hands out, in physical pixels: the size
    /// the program draws its pictures at, kept until set again, whatever the view's size, and
    /// taken from the canvas's next texture on. The canvas has no size until one is set:
    /// configuring a context on it, or taking a texture, before then traps the program, as does
    /// a size of zero, or one past the largest 2D texture of the device the context is
    /// configured against.
    set-canvas-size: func(width: u32, height: u32);

    /// The view's current geometry.
    metrics: func() -> metrics;

    /// Everything that happens to this view and to what holds it, in the order it happened,
    /// from the view's opening on. Nothing is lost: while the program is behind, a pointer's
    /// consecutive moves are merged into the latest, and so are consecutive changes of
    /// geometry. A view has one reader: the first call takes the stream, and a later one
    /// answers none. The stream ends when the view is gone.
    events: func() -> option<stream<view-event>>;

    /// Asks for one `frame` event, the view's one frame of a refresh of the screen it is on:
    /// of the refresh the screen is in, at once, when the view has had no frame of it, and of
    /// the next refresh when it has, or where the system cannot tell which refresh the screen
    /// is in. Asking again before it arrives changes nothing. None arrive while the view is not
    /// on screen, or on no screen: the frame asked for then arrives at the first refresh after
    /// it is.
    request-frame: func();

    /// Sets the layers beneath the view's picture, each with its placement, the bottom-most
    /// first. They are kept until set again, and the view's next present shows them; a layer the
    /// list does not name is taken off with that present's picture.
    set-layers: func(layers: list<placed-layer>);

    /// Puts the texture last taken from the context on screen, with the view's layers beneath
    /// it, once the GPU has finished the work the program submitted and the writes it queued
    /// before this call. A present with no picture drawn since the last does nothing, its layers
    /// included, since a layer moves with the picture that makes room for it: layers set since
    /// wait for the next picture.
    present: func();

    /// The cursor to show while a pointer is over this view.
    set-cursor: func(cursor: cursor);

    /// How the platform's input methods and on-screen keyboard edit text the program draws in
    /// this view; none where the platform has no text input for it.
    text-input: func() -> option<text-input>;

    /// Asks the platform to give this view the input focus, or to take it away: Flutter's
    /// `requestViewFocusChange`. A platform that cannot move its focus does nothing.
    request-focus-change: func(state: view-focus-state, direction: view-focus-direction);

    /// Says whether the program goes back within itself when the user asks: Flutter's
    /// `SystemNavigator.setFrameworkHandlesBack`. While it does, the user's Back arrives among the
    /// view's events as `pop-route`; while it does not, the platform does its own with the press,
    /// as leaving the program for the home, and the program hears nothing. A view starts not
    /// handling Back, and keeps what was said last.
    set-handles-back: func(handles: bool);

    /// Sets the style of the system's bars drawn over this view, the status bar and Android's
    /// navigation bar: Flutter's `SystemChrome.setSystemUIOverlayStyle`, for one view. A field
    /// left out keeps what the platform has; a platform with no such bars, or a view it draws
    /// none over, ignores it. A view starts with the platform's style, and keeps what was said
    /// last. Replaced by `system-bars`, whose `set-overlay-style` reaches the same bars where
    /// there are some; this keeps working until 3.0.
    @since(version = 2.1.0)
    @deprecated(version = 2.2.0)
    set-overlay-style: func(style: overlay-style);

    /// The platform's own bars over the view: the status bar, and the navigation bar or the home
    /// indicator. None where the platform draws no bars over a view, as on a desktop, whose
    /// windows have their own frame.
    @since(version = 2.2.0)
    system-bars: func() -> option<system-bars>;
  }

  /// What the program says about the bars over one view: Flutter's `SystemChrome`, for this
  /// view alone. It keeps what was said last, as the view does.
  @since(version = 2.2.0)
  resource system-bars {
    /// How the bars and their icons look over the view: Flutter's
    /// `SystemChrome.setSystemUIOverlayStyle`.
    set-overlay-style: func(style: overlay-style);
    /// Hides the bars over the view until `show`; what a swipe from a screen's edge does
    /// meanwhile is `swipe`'s. Flutter's `SystemUiMode.immersive` is `hide(system)`,
    /// `immersiveSticky` is `hide(deferred)`.
    hide: func(swipe: edge-swipe);
    /// Shows the bars again, drawn over the view: how a view starts. Flutter's
    /// `SystemUiMode.edgeToEdge`.
    show: func();
  }

  @since(version = 2.2.0)
  enum edge-swipe {
    /// The system acts on it as it always does, the bars coming back with it.
    system,
    /// The first swipe only shows the bars, for a moment, and the view keeps the touch; a
    /// second swipe acts: Android's transient bars, iOS's deferred edge gestures. For a game,
    /// where a stray swipe must not leave it.
    deferred,
  }

  /// The style of the system's bars over a view: Flutter's `SystemUiOverlayStyle` without the
  /// bars' colours, which Android ignores for an app drawn under its bars and iOS never had.
  record overlay-style {
    /// The status bar's icons and text, `dark` over a light page: Android's
    /// `APPEARANCE_LIGHT_STATUS_BARS` for `dark`, iOS's `darkContent` for `dark` and
    /// `lightContent` for `light`.
    status-bar-icons: option<brightness>,
    /// The buttons of Android's navigation bar: `APPEARANCE_LIGHT_NAVIGATION_BARS` for `dark`.
    navigation-bar-icons: option<brightness>,
    /// Whether the system may put a scrim behind the status bar, for contrast: Android's
    /// `setStatusBarContrastEnforced`.
    status-bar-contrast-enforced: option<bool>,
    /// The same for the navigation bar: Android's `setNavigationBarContrastEnforced`.
    navigation-bar-contrast-enforced: option<bool>,
  }

  /// A change among the program's views, in the order the changes happened.
  variant view-change {
    /// A view the program now has, arrived for a request, whose id it carries.
    added(view),
    /// A view the program no longer has: its window was closed, or the shell took it away.
    /// Its events have ended.
    removed(view-id),
    /// A request got no view.
    request-failed(request-failure),
  }

  /// Which request got no view, and why.
  record request-failure {
    request: request-id,
    error: view-error,
  }

  /// The views the program has now, in the order they arrived.
  views: func() -> list<view>;

  /// What changes among the program's views from now on. Each call is a stream of its own.
  view-changes: func() -> stream<view-change>;

  /// Asks the shell for a view in a window made as `config` says, carrying `initial-data` back
  /// to the program as the view's own. The shell answers at once whether it takes the request;
  /// the view itself arrives later on `view-changes` as `added`, carrying this id, once the
  /// shell has placed it, or `request-failed` with this id when it could not.
  request-view: func(config: borrow<window-config>, initial-data: option<string>) -> result<request-id, view-error>;

  /// The platform's side of text the program edits in a view: Flutter's text input connection,
  /// one call for each of Flutter's text input calls. A client is one text field's hold on the
  /// connection: `set-client` gives it to a new field, which a platform whose input method keeps
  /// its state by the field it edits, as iOS's does, gives a field of its own. Every handle on it
  /// reaches the same connection.
  resource text-input {
    /// A new client, configured with `configuration`, has the connection from now on, and the
    /// input methods edit its text: Flutter's `TextInput.setClient`. The on-screen keyboard shows
    /// only at `show`.
    set-client: func(configuration: text-input-configuration);

    /// The input method shows for the current client, the on-screen keyboard where there is
    /// one: Flutter's `TextInput.show`.
    show: func();

    /// The current client's configuration changed, the client staying the same: Flutter's
    /// `TextInput.updateConfig`.
    update-config: func(configuration: text-input-configuration);

    /// The value the program holds now: Flutter's `TextInput.setEditingState`.
    set-editing-state: func(value: text-editing-value);

    /// Where the caret is, for the input method's candidate window: Flutter's
    /// `TextInput.setCaretRect`.
    set-caret-rect: func(rect: pixel-rect);

    /// Where the text being composed is: Flutter's `TextInput.setMarkedTextRect`.
    set-composing-rect: func(rect: pixel-rect);

    /// The current client gave the connection up, and the input method drops what it was
    /// composing: Flutter's `TextInput.clearClient`. The on-screen keyboard stays until `hide`,
    /// so a field taking the connection next keeps it up.
    clear-client: func();

    /// The input method goes, the on-screen keyboard with it: Flutter's `TextInput.hide`.
    hide: func();
  }

  /// Everything that happens to a view, in the order it happened.
  variant view-event {
    /// The frame asked for with `request-frame`, after every event before it.
    frame(frame),
    /// The view's geometry changed: a resize, a move to another screen, system UI coming
    /// and going.
    metrics(metrics),
    /// A pointer: a mouse, a finger, a stylus.
    pointer(pointer-event),
    /// A key, while this view has the keyboard's focus, with the reply the platform waits on.
    /// Modifier keys the platform saw change while the program was not told, as around a click
    /// in another window, arrive as `synthesized` keys before the pointer event that revealed
    /// them; nothing waits on their replies.
    key(key-input),
    /// The view gained or lost the input focus: Flutter's `onViewFocusChange`.
    focus(view-focus-event),
    /// An input method changed the text; this is the whole value after the change. Flutter's
    /// `updateEditingState`.
    text-input-editing-value(text-editing-value),
    /// The user asked for the configured action: done, next, search, a new line. Flutter's
    /// `performAction`.
    text-input-action(text-input-action),
    /// The platform ended editing: Flutter's `onConnectionClosed`.
    text-input-closed,
    /// The user copied what is selected in this view, through the platform's command: Edit's
    /// Copy, or ⌘C the program left unhandled. The request writes it whatever the program's
    /// write switch says.
    copy(copy-request),
    /// The user cut what is selected in this view, through the platform's command: written as
    /// `copy` writes it, then deleted.
    cut(copy-request),
    /// The user pasted into this view, through the platform's command: what was on the
    /// clipboard then, which the program reads whatever its read switch says.
    paste(paste),
    /// The user asked to undo, redo, select everything or delete what is selected in this view,
    /// through the platform's command.
    edit(edit-command),
    /// The user asked to close what holds the view. The program decides, and nothing happens
    /// until it does: on a view in a window, a program that agrees closes the window; on a view
    /// in no window, such as a phone's tab, a program that agrees ends itself, by returning
    /// from its `main`.
    close-requested,
    /// The user asked to go back, as Android's back button and back gesture do, while the program
    /// says it handles that (`set-handles-back`): Flutter's `popRoute`. The program goes back
    /// within itself; nothing waits for it, and it says it no longer handles Back once it has
    /// nowhere left to go back to.
    pop-route,
  }

  /// A view's geometry, in physical pixels.
  record metrics {
    width: u32,
    height: u32,
    /// Physical pixels per logical pixel.
    device-pixel-ratio: f64,
    /// The edges the platform's own UI, or the hardware, may cover at the moment: a
    /// status bar, a notch. Content that must be seen keeps clear of it.
    padding: insets,
    /// The edges the platform's UI may cover at any time, whether or not it does now.
    view-padding: insets,
    /// The edges the platform's UI covers completely at the moment: a keyboard.
    view-insets: insets,
  }

  /// Distances from a view's four edges, in physical pixels.
  record insets {
    left: f64,
    top: f64,
    right: f64,
    bottom: f64,
  }

  /// A rectangle in a view's physical pixels, from its top-left corner.
  record pixel-rect {
    x: f64,
    y: f64,
    width: f64,
    height: f64,
  }

  record view-focus-event {
    state: view-focus-state,
    direction: view-focus-direction,
  }

  enum view-focus-state {
    unfocused,
    focused,
  }

  /// How the focus moved: `forward` for Tab, `backward` for Shift-Tab, `undefined` otherwise.
  enum view-focus-direction {
    undefined,
    forward,
    backward,
  }

  /// Flutter's `TextEditingValue`: the text, where the selection is, and what is being composed.
  record text-editing-value {
    text: string,
    /// None when there is neither a caret nor a selection.
    selection: option<text-selection>,
    /// None when nothing is being composed.
    composing: option<text-range>,
  }

  /// Flutter's `TextSelection`: from where it started to where it ends now, which is the caret
  /// when the two are the same.
  record text-selection {
    base-offset: u32,
    extent-offset: u32,
    affinity: text-affinity,
    /// Whether the selection has a direction the user gave it, rather than one it was given.
    is-directional: bool,
  }

  record text-range {
    start: u32,
    end: u32,
  }

  /// Which side of a line break an offset at the break belongs to.
  enum text-affinity {
    upstream,
    downstream,
  }

  /// What the text is for, so the platform can pick a keyboard and its input methods'
  /// behaviour. Every field is a hint a platform may ignore.
  record text-input-configuration {
    input-type: text-input-type,
    input-action: text-input-action,
    obscure-text: bool,
    autocorrect: bool,
    enable-suggestions: bool,
    text-capitalization: text-capitalization,
    read-only: bool,
  }

  /// Flutter's `TextInputType`.
  variant text-input-type {
    text,
    multiline,
    number(number-format),
    phone,
    datetime,
    email-address,
    url,
    visible-password,
    name,
    street-address,
    none,
    web-search,
    twitter,
  }

  record number-format {
    signed: bool,
    decimal: bool,
  }

  /// Flutter's `TextInputAction`.
  enum text-input-action {
    none,
    unspecified,
    done,
    go,
    search,
    send,
    next,
    previous,
    continue-action,
    join,
    route,
    emergency-call,
    newline,
  }

  /// Flutter's `TextCapitalization`.
  enum text-capitalization {
    words,
    sentences,
    characters,
    none,
  }

  /// A frame the program asked for.
  record frame {
    /// When the screen's refresh this frame is for began; what animations advance to.
    time: instant,
    /// When this frame's picture is expected to reach the screen: what a video's frame is asked
    /// for.
    display-time: instant,
    /// The program's views this refresh serves, this one among them; each gets this frame on
    /// its own stream, after every event before it there.
    views: list<view-id>,
  }

  /// What one pointer did, in the vocabulary of Flutter's `PointerData`, so that a
  /// framework built on that model maps it one to one.
  record pointer-event {
    /// When the event happened, in nanoseconds on the input events' own clock, the system's
    /// stamp passed through: comparable with the time of any other pointer or key event, to tell
    /// how far apart they came, as a velocity tracker does, and not with the program's other
    /// clocks, a frame's `time` and `wasi:clocks` among them.
    time: u64,
    change: pointer-change,
    kind: pointer-device-kind,
    signal: pointer-signal-kind,
    /// Which pointer of its kind: a finger, a mouse. Stable while it is on the view.
    device: s64,
    /// The position, in physical pixels from the view's top-left corner.
    x: f64,
    y: f64,
    buttons: pointer-buttons,
    /// Pressure from 0 to 1 for devices that measure it; 1, with 1 as both bounds, for
    /// those that do not.
    pressure: f64,
    pressure-min: f64,
    pressure-max: f64,
    /// Height above the input surface, in the device's own units; 0 while down, and
    /// `distance-max` is 0 for devices that cannot hover.
    distance: f64,
    distance-max: f64,
    /// The area pressed, from 0 to 1, where the device reports it.
    size: f64,
    /// The contact ellipse, in physical pixels, and its bounds for this device.
    radius-major: f64,
    radius-minor: f64,
    radius-min: f64,
    radius-max: f64,
    /// The contact ellipse's angle from the y axis, in radians; for a stylus, the angle
    /// of its projection onto the surface.
    orientation: f64,
    /// A stylus's angle from the surface normal, in radians.
    tilt: f64,
    /// For `signal` `scroll`: how far to scroll, in physical pixels.
    scroll-delta-x: f64,
    scroll-delta-y: f64,
    /// For `pan-zoom-update`: the gesture's total pan in physical pixels, scale with 1 as
    /// the start, and rotation in radians.
    pan-x: f64,
    pan-y: f64,
    scale: f64,
    rotation: f64,
  }

  enum pointer-change {
    /// The input from this pointer is cancelled.
    cancel,
    /// The pointer is on the view: a mouse entered it, a stylus came into range.
    add,
    /// The pointer left the view.
    remove,
    /// The pointer moved with no button held.
    hover,
    /// A button went down.
    down,
    /// The pointer moved with a button held, or its buttons changed while one is held.
    move,
    /// The last button came up.
    up,
    pan-zoom-start,
    pan-zoom-update,
    pan-zoom-end,
  }

  enum pointer-device-kind {
    touch,
    mouse,
    stylus,
    inverted-stylus,
    trackpad,
  }

  /// A signal is an event that is not a movement of the pointer: it happens at the
  /// pointer's position without changing its state.
  enum pointer-signal-kind {
    none,
    scroll,
    /// A scroll with momentum stopped.
    scroll-inertia-cancel,
    scale,
  }

  /// The buttons held, as bits: the primary button is 1, the secondary 2, and so on.
  flags pointer-buttons {
    primary,
    secondary,
    tertiary,
    back,
    forward,
  }

  /// One of Edit's commands, which the platform's menu or its keys send the focused view.
  enum edit-command {
    undo,
    redo,
    select-all,
    delete,
  }

  /// A key, and the reply the platform waits on: whether the program handled it.
  record key-input {
    event: key-event,
    reply: key-reply,
  }

  /// Whether the program handled a key, as Flutter's embedder API answers each key it sends. The
  /// program has every key first; one it did not handle goes on past it, to the platform's menus,
  /// as ⌘C left unhandled reaches Edit's Copy, which sends the view `copy`. Dropped without an
  /// answer, the key was not handled, so a program that forgets one never holds a key.
  resource key-reply {
    /// Answers whether the program handled the key. Only the first answer counts.
    handled: func(handled: bool);
  }

  /// A key went down, repeated or came up, in the vocabulary of Flutter's `KeyData`.
  record key-event {
    /// When the event happened, in nanoseconds on the input events' own clock, the system's
    /// stamp passed through: comparable with the time of any other pointer or key event, to tell
    /// how far apart they came, as a velocity tracker does, and not with the program's other
    /// clocks, a frame's `time` and `wasi:clocks` among them.
    time: u64,
    kind: key-kind,
    device: key-device,
    /// Where the key is: its USB HID usage, with the usage page in the high 16 bits
    /// (`0x0007_0004` is the key at `A` on a US keyboard).
    physical: u64,
    /// What the key means under the current layout: a character key's lower-case code
    /// point, else Flutter's id for the named key.
    logical: u64,
    /// The text the key produced, if any. Nothing on `up`.
    character: option<string>,
    /// Made up by the platform to keep the program's picture of the keyboard right, as a
    /// release it missed while another window had the focus.
    synthesized: bool,
  }

  enum key-kind {
    down,
    up,
    repeat,
  }

  enum key-device {
    keyboard,
    directional-pad,
    gamepad,
    joystick,
    hdmi,
  }

  /// A pointer's shape, by its CSS name; `none` hides it.
  enum cursor {
    none,
    default,
    context-menu,
    help,
    pointer,
    progress,
    wait,
    cell,
    crosshair,
    text,
    vertical-text,
    alias,
    copy,
    move,
    no-drop,
    not-allowed,
    grab,
    grabbing,
    e-resize,
    n-resize,
    ne-resize,
    nw-resize,
    s-resize,
    se-resize,
    sw-resize,
    w-resize,
    ew-resize,
    ns-resize,
    nesw-resize,
    nwse-resize,
    col-resize,
    row-resize,
    all-scroll,
    zoom-in,
    zoom-out,
  }
}
