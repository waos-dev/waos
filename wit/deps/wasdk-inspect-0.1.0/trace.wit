/// What a program does, live, one stream per capability. Holding a stream is being attached: events
/// flow from when it is asked for, and stop when it is dropped; nothing is made for a capability
/// nobody listens to. A listener that falls behind loses events, and the next one it reads says how
/// many.
interface trace {
  use wasi:clocks/system-clock@0.3.0.{instant};
  use wasi:clocks/monotonic-clock@0.3.0.{duration};
  use devices.{device};
  use audit.{mount-kind};

  /// What WaOS decided: allowed, refused by the setting the key names (`network`,
  /// `local-network`, `domains`, `folders`, `clipboard-read`, `camera`…), or failed, no setting
  /// deciding it.
  variant verdict {
    allowed,
    refused(string),
    failed,
  }

  /// Which instance of the program: its main one, 0, or a worker, from 1 as they started.
  type instance = u32;

  /// Who a use was for: the program itself, or what it asked to act for it.
  enum cause {
    program,
    /// An HTTP request of the program's, whose host is looked up to send it.
    http-request,
    /// A media player or the reading of media, which the system opens a link or a file for.
    media-player,
    /// The system's app a file or link is opened in, or its file manager.
    opener,
    /// The system's codecs, which read an image's file.
    image-codecs,
    /// A file dialog, which opens at a folder.
    file-dialog,
    /// Whatever the user pastes a file the program copied into.
    clipboard,
  }

  /// A name looked up.
  record name-lookup {
    name: string,
    cause: cause,
    /// The addresses answered; none for a lookup refused or failed.
    addresses: list<string>,
  }

  /// A TCP connection made or accepted.
  record tcp-connection {
    /// The address at the other end.
    address: string,
    port: u16,
    /// The names the address was looked up by, which the domain rule judged it by.
    names: list<string>,
  }

  /// A UDP datagram.
  record udp-datagram {
    /// The address it was sent to or came from.
    address: string,
    port: u16,
    /// Whether it was sent; received otherwise.
    sent: bool,
  }

  /// An HTTP request the program sent.
  record http-request {
    /// The request's id among the program's, which its response names.
    id: u64,
    method: string,
    url: string,
  }

  /// The head of an HTTP request's response.
  record http-response {
    /// The id of the request it answers.
    request-id: u64,
    status: u16,
    /// How long after the request was sent its head came.
    time-to-head: duration,
  }

  variant network-use {
    name-lookup(name-lookup),
    tcp-connect(tcp-connection),
    tcp-accept(tcp-connection),
    /// A TCP socket listening, at its port.
    tcp-listen(u16),
    udp-datagram(udp-datagram),
    http-request(http-request),
    http-response(http-response),
  }

  record network-event {
    at: instant,
    instance: instance,
    /// Events dropped before this one because the reader fell behind.
    dropped-before: u32,
    kind: network-use,
    verdict: verdict,
  }

  /// A folder watched.
  record watch-options {
    /// Whether everything under it is watched too.
    recursive: bool,
  }

  variant file-use {
    open-to-read,
    open-to-write,
    create-directory,
    remove,
    remove-directory,
    /// Renamed to this path, as the program named it.
    rename(string),
    /// A hard link made at this path, as the program named it.
    hard-link(string),
    /// A symlink holding this made.
    symlink(string),
    set-times,
    /// Its metadata read: a status, a symlink read or a hash, noted, not decided.
    metadata-read,
    /// The first write through a handle.
    first-write,
    folder-watch(watch-options),
  }

  record file-event {
    at: instant,
    instance: instance,
    /// Events dropped before this one because the reader fell behind.
    dropped-before: u32,
    /// The path as the program named it; none for a write through a handle.
    path: option<string>,
    /// Where it is on the machine; none where it led nowhere.
    on-machine: option<string>,
    /// The mount it is in; none where it led nowhere.
    mount: option<mount-kind>,
    cause: cause,
    kind: file-use,
    verdict: verdict,
  }

  /// The clipboard read.
  record clipboard-read {
    /// The form read, as its MIME type names it.
    form: string,
    /// Whether the user pasted what was read, which reads past the read switch.
    pasted: bool,
  }

  variant clipboard-use {
    read(clipboard-read),
    /// The forms written, as their MIME types name them.
    write(list<string>),
  }

  record clipboard-event {
    at: instant,
    instance: instance,
    /// Events dropped before this one because the reader fell behind.
    dropped-before: u32,
    kind: clipboard-use,
    verdict: verdict,
  }

  /// A camera or the microphone opened.
  record device-opened {
    /// The camera, by the id the program opened it by; none for the microphone.
    camera-id: option<string>,
    /// Whether it is one of WaOS's own, simulated, rather than the machine's.
    simulated: bool,
  }

  variant device-use {
    opened(device-opened),
    /// A camera's session started, or the microphone recording.
    capture-started,
    /// The capture ended, after so long.
    capture-ended(duration),
  }

  record device-event {
    at: instant,
    instance: instance,
    /// Events dropped before this one because the reader fell behind.
    dropped-before: u32,
    kind: device-use,
    verdict: verdict,
  }

  /// A command started on a machine.
  record started-command {
    /// The machine, by its name.
    machine: string,
    /// The program the command runs, as the program named it.
    command: string,
    arguments: list<string>,
    /// Whether it runs in a terminal; with pipes otherwise.
    in-terminal: bool,
  }

  variant machine-use {
    /// A machine the user picked, by its id.
    machine-picked(string),
    command-started(started-command),
    /// A command ended, after so long.
    command-ended(duration),
  }

  record machine-event {
    at: instant,
    instance: instance,
    /// Events dropped before this one because the reader fell behind.
    dropped-before: u32,
    kind: machine-use,
    verdict: verdict,
  }

  /// A question's answer.
  record question-answer {
    /// The question, by its row's key.
    question: string,
    /// The answer, by its key; none when nobody answered.
    answer: option<string>,
  }

  variant permission-use {
    /// A question put to the user, by its row's key.
    question-asked(string),
    question-answered(question-answer),
    /// A switch's page opened for the user, by the switch's key.
    settings-opened(string),
    /// A file or folder mounted by a pick, where it is on the machine.
    pick-mounted(string),
  }

  record permission-event {
    at: instant,
    instance: instance,
    /// Events dropped before this one because the reader fell behind.
    dropped-before: u32,
    kind: permission-use,
  }

  record link-event {
    at: instant,
    instance: instance,
    /// Events dropped before this one because the reader fell behind.
    dropped-before: u32,
    /// The link, as the program named it.
    link: string,
    verdict: verdict,
  }

  /// A notification posted.
  record notification-event {
    at: instant,
    instance: instance,
    /// Events dropped before this one because the reader fell behind.
    dropped-before: u32,
    verdict: verdict,
  }

  enum output-stream {
    stdout,
    stderr,
  }

  /// What the program wrote to its standard output or errors, as it wrote it.
  record output-chunk {
    at: instant,
    instance: instance,
    /// Events dropped before this one because the reader fell behind.
    dropped-before: u32,
    channel: output-stream,
    bytes: list<u8>,
  }

  /// Each capability's events of the program `id` names, from now on; none for a program that
  /// does not run.
  network: func(device: borrow<device>, id: string) -> option<stream<network-event>>;
  files: func(device: borrow<device>, id: string) -> option<stream<file-event>>;
  clipboard: func(device: borrow<device>, id: string) -> option<stream<clipboard-event>>;
  camera: func(device: borrow<device>, id: string) -> option<stream<device-event>>;
  microphone: func(device: borrow<device>, id: string) -> option<stream<device-event>>;
  machines: func(device: borrow<device>, id: string) -> option<stream<machine-event>>;
  permissions: func(device: borrow<device>, id: string) -> option<stream<permission-event>>;
  links: func(device: borrow<device>, id: string) -> option<stream<link-event>>;
  notifications: func(device: borrow<device>, id: string) -> option<stream<notification-event>>;
  output: func(device: borrow<device>, id: string) -> option<stream<output-chunk>>;
}
