/// What a program uses now, as a stream: what is active as it is asked for, then each start and
/// end. Each use that lasts is here from the moment what owns the real thing starts it until that
/// thing really ends, and each file the program has open until its last handle goes. A listener
/// that falls behind is sent everything active again in place of the changes it missed, so it
/// never shows a use that ended; the program never waits for it.
interface active-uses {
  use wasi:clocks/system-clock@0.3.0.{instant};
  use devices.{device};
  use audit.{mount-kind};

  /// What a program uses now.
  variant active-use-kind {
    /// A camera's capture session.
    camera(capture),
    /// The microphone recording.
    microphone(capture),
    /// A command running on a machine.
    command(running-command),
    /// An HTTP request in flight, until its response's body ends.
    http-request(http-request),
    /// A folder watched.
    folder-watch(folder-watch),
    /// A file or folder open.
    open-file(open-file),
    /// A TCP connection, until its socket closes.
    tcp-connection(tcp-connection),
    /// A TCP socket listening, at this address, until it closes.
    tcp-listener(socket-address),
    /// A UDP socket, until it closes.
    udp-socket(udp-socket),
  }

  /// A camera or the microphone capturing.
  record capture {
    /// Whether it captures from one of WaOS's own devices, simulated, rather than the machine's.
    simulated: bool,
  }

  /// A command running on a machine.
  record running-command {
    /// The machine, by its name.
    machine: string,
    /// The program the command runs, as the program named it.
    command: string,
    /// Whether it runs in a terminal; with pipes otherwise.
    in-terminal: bool,
  }

  /// An HTTP request in flight.
  record http-request {
    method: string,
    url: string,
  }

  /// A folder watched.
  record folder-watch {
    /// Where it was on the machine when the watch began.
    folder: string,
    /// Whether everything under it is watched too.
    recursive: bool,
  }

  /// A file or folder open.
  record open-file {
    /// Where the system says it is as this is sent; none where it cannot say.
    path: option<string>,
    /// The kind of mount it was opened in.
    mount: mount-kind,
    /// Whether it was opened to read.
    read: bool,
    /// Whether it was opened to write.
    write: bool,
  }

  /// An address, and a port at it.
  record socket-address {
    address: string,
    port: u16,
  }

  /// How a TCP connection came to be.
  enum tcp-connection-origin {
    /// The program connected.
    connected,
    /// The program's listener accepted it.
    accepted,
    /// WaOS connected, to send the program's HTTP requests.
    http-request,
  }

  /// A TCP connection, and what it moved as this is sent.
  record tcp-connection {
    origin: tcp-connection-origin,
    /// This end; none where the system could not say.
    local: option<socket-address>,
    /// The other end: the server, the program's peer, or the proxy a request went through.
    remote: socket-address,
    /// The names the other end's address was looked up by as the connection was made, which the
    /// domain rule judged it by.
    names: list<string>,
    /// The bytes sent, as this is sent.
    bytes-sent: u64,
    /// The bytes received, as this is sent.
    bytes-received: u64,
  }

  /// A UDP socket, and what it moved as this is sent.
  record udp-socket {
    /// Where it is bound, as this is sent; none until it is.
    local: option<socket-address>,
    /// Where it is connected, as this is sent; none while it sends anywhere.
    remote: option<socket-address>,
    /// The bytes of the datagrams sent, as this is sent.
    bytes-sent: u64,
    /// The bytes of the datagrams handed to the program, as this is sent.
    bytes-received: u64,
  }

  /// A use active now.
  record active-use {
    /// Its id among the program's uses, which its end names.
    id: u64,
    kind: active-use-kind,
    since: instant,
  }

  /// A change to what a program uses now.
  variant active-use-change {
    started(active-use),
    /// The use of this id ended.
    ended(u64),
    /// Everything active now, in place of the changes the listener fell behind on.
    resync(list<active-use>),
  }

  /// What the program `id` names uses now, and each change from then on, until it ends; none for
  /// a program that does not run.
  active-uses: func(device: borrow<device>, id: string) -> option<tuple<list<active-use>, stream<active-use-change>>>;
}
