package wasdk:program@0.1.0;

/// A program the platform runs. Its world is a package of its own above the two it imports from:
/// `wasdk:platform`, and `wasdk:media`, the media interfaces, versioned apart from the rest.
///
/// Its entry is WASI's own: `wasi:cli/run`, which the engine calls and which is alive until it
/// returns. A program that draws does so on views through WebGPU; one that does not is an ordinary
/// WASI command, and runs here too.
///
/// The worlds are two, as `wasi:cli`'s `imports` and `command` are: `program-base`, what a program
/// imports and its `worker-entry`, which wasdk generates its bindings from, and `program`, that and
/// `wasi:cli/run`, which the engine runs. A program's `run` is not wasdk's but Rust's standard
/// library's, its `main` on `wasm32-wasip3`, inside which `#[wasdk::main]` runs the program; WaOS
/// refuses to start a component without it. Its views are given by the shell that embeds the engine or
/// asked for through `views`; the screens they are on and what the user set up are `screens` and
/// `system`; a desktop's frame around a view is `windows`; and how much of the program its user can
/// see, and the platform asking whether it may end, is `lifecycle`.
///
/// Everything else a program reaches (files, with `/data` and `/cache` of its own and a `/tmp`
/// emptied when it ends; the network; fonts; machines; sound) is a capability the engine serves
/// through an interface of its own, chosen per program when it starts. So far `fonts`, the installed fonts and their glyphs; the
/// network, as WASI 0.3's sockets, which Rust's `std::net` imports and a program awaits, and WASI
/// 0.3's HTTP client, with `trust`, the system's check of a server's
/// certificate; `audio`, sound, a Web Audio graph
/// the platform renders and plays, with the microphone among its inputs; and `machines`, the
/// machines its user picked for it, their files and their commands. What changes in a folder it
/// holds, its own or a mount or a machine's, the system tells it through `file-watching`, beside
/// `wasi:filesystem`, whose preopened root it opens its folders from. The others arrive in later
/// steps of the design. The clipboard is the user's, wherever the program runs, and reached through
/// the platform: `clipboard`. Its menus are shown in the platform's places for them, its menu bar,
/// context menus and tray icons, where it has them: `menus`; files the user picks in the platform's
/// dialogs are mounted for it: `file-dialogs`; links and files it names open in the app the system
/// picks: `opener`; the system's notifications show what it posts: `notifications`; GPU memory the
/// compositor shows, which the program allocates and presents on a composition layer it places:
/// `hardware-buffers`; that memory shared with the program's own GPU device, as a texture it draws
/// into and samples: `gpu-interop`; and the system's player plays its
/// media, drawing the picture on a composition layer the program places, or lending its frames to
/// the program, each with a hardware buffer it draws: `media-players` and `video-frames`; and the
/// system reads media without playing it, its length, tracks, tags and a picture at a time, for a
/// library's lengths, titles and thumbnails: `media-assets`; and the system's codecs decode and
/// encode its images, into its own memory and out of it, and where the system can, into hardware
/// buffers and out of them: `image-codecs`; and the system's cameras run for it, their preview on a
/// composition layer it places, their frames in a frame reader and their photos encoded by the
/// system: `cameras`; and how the user set captions to look, which the program draws its subtitles
/// in: `caption-settings`. What of all this the user lets the program use is `permissions`.
///
/// Parallel work is `workers`: another instance of the program's code, sharing nothing with it,
/// started at an entry its `worker-entry` export runs, with the IO side and none of the user's.
/// A program written with wasdk exports it whether or not it has workers, and answers an entry it
/// does not have as unknown.
world program-base {
  include wasi:webgpu/imports@0.3.0-rc.2;
  import wasi:clocks/monotonic-clock@0.3.0;
  include wasi:sockets/imports@0.3.0;
  import wasi:http/client@0.3.0;
  import wasi:filesystem/preopens@0.3.0;
  import wasdk:platform/views@0.1.0;
  import wasdk:platform/screens@0.1.0;
  import wasdk:platform/windows@0.1.0;
  import wasdk:platform/system@0.1.0;
  import wasdk:platform/lifecycle@0.1.0;
  import wasdk:platform/fonts@0.1.0;
  import wasdk:platform/permissions@0.1.0;
  import wasdk:platform/trust@0.1.0;
  import wasdk:platform/clipboard@0.1.0;
  import wasdk:platform/menus@0.1.0;
  import wasdk:platform/audio@0.1.0;
  import wasdk:platform/file-dialogs@0.1.0;
  import wasdk:platform/opener@0.1.0;
  import wasdk:platform/notifications@0.1.0;
  import wasdk:platform/machines@0.1.0;
  import wasdk:platform/file-watching@0.1.0;
  import wasdk:platform/hardware-buffers@0.1.0;
  import wasdk:platform/gpu-interop@0.1.0;
  import wasdk:media/video-frames@0.1.0;
  import wasdk:media/media-players@0.1.0;
  import wasdk:media/media-assets@0.1.0;
  import wasdk:media/image-codecs@0.1.0;
  import wasdk:media/cameras@0.1.0;
  import wasdk:media/caption-settings@0.1.0;
  import wasdk:platform/workers@0.1.0;
  export wasdk:platform/worker-entry@0.1.0;
}

/// A program as the engine runs it: `program-base` and its entry.
world program {
  include program-base;
  export wasi:cli/run@0.3.0;
}

/// A program with the inspector role: everything a program has, and `wasdk:inspect`, which WaOS
/// links only for a program its user granted the role.
world inspector-base {
  include program-base;
  import wasdk:inspect/devices@0.1.0;
  import wasdk:inspect/audit@0.1.0;
  import wasdk:inspect/active-uses@0.1.0;
  import wasdk:inspect/trace@0.1.0;
  import wasdk:inspect/storage@0.1.0;
}
