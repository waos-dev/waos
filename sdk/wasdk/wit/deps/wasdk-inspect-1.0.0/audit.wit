/// What each program did with what it was allowed, over the last seven days, as the device keeps
/// it: counts, refusals, first and last use, and short lists, each capped, what fell beyond a cap
/// counted. Never what a use read or wrote.
interface audit {
  use wasi:clocks/system-clock@0.3.0.{instant};
  use devices.{device};

  /// How often a use happened, how often it was refused, and when it first and last happened;
  /// none while it has not.
  record uses {
    allowed: u32,
    refused: u32,
    first: option<instant>,
    last: option<instant>,
  }

  /// The uses of one thing, by its name.
  record named-uses {
    /// What was used: a domain, an address, a scheme and host.
    name: string,
    uses: uses,
  }

  /// The runs of one command on one machine.
  record command-uses {
    /// The machine, by its name.
    machine: string,
    /// The program the command ran, as the program named it; never its arguments.
    command: string,
    uses: uses,
  }

  /// What a mount is to the program.
  enum mount-kind {
    /// Its own `/data`.
    own-data,
    /// Its own `/cache`.
    own-cache,
    /// Its own `/tmp`, emptied when it ends.
    own-temporary,
    /// A folder its user granted it.
    granted,
    /// A file or folder its user picked for it.
    picked,
    /// A file or folder its user pasted into it.
    pasted,
    /// A machine its user gave it whole.
    machine,
  }

  /// What a program did in one mount.
  record folder-uses {
    /// Where the mount is on the machine.
    path: string,
    kind: mount-kind,
    opened-to-read: u32,
    opened-to-write: u32,
    created: u32,
    removed: u32,
    renamed: u32,
    /// The files changed in it, in the user's mounts only, a hundred a day at most.
    changed: list<string>,
  }

  /// A camera's session, or the microphone recording.
  record device-session {
    start: instant,
    /// How long it lasted, in whole seconds.
    seconds: u32,
    /// Whether it captured from one of WaOS's own devices, simulated, rather than the machine's.
    simulated: bool,
  }

  /// A question put to the user, and its answer.
  record question-asked {
    /// The question, by its row's key: `camera`, `microphone`, `notifications`,
    /// `link-scheme zoommtg`.
    question: string,
    at: instant,
    /// The answer, by its key; none when nobody answered.
    answer: option<string>,
  }

  /// How many fell beyond each list's cap.
  record overflow {
    domains: u32,
    local-addresses: u32,
    folders: u32,
    /// The files changed, all folders together.
    changed: u32,
    commands: u32,
    links: u32,
    /// The camera's and the microphone's sessions together.
    device-sessions: u32,
    questions: u32,
  }

  /// One day, from midnight UTC.
  record day {
    start: instant,
    domains: list<named-uses>,
    local-addresses: list<named-uses>,
    udp-datagrams: u64,
    folders: list<folder-uses>,
    /// The opens and changes the mounts refused: outside every folder, or a change a read-only
    /// one does not allow.
    folder-refusals: u32,
    clipboard-reads: uses,
    pastes: u32,
    clipboard-writes: uses,
    camera: list<device-session>,
    microphone: list<device-session>,
    commands: list<command-uses>,
    links: list<named-uses>,
    notifications: uses,
    questions: list<question-asked>,
    beyond-caps: overflow,
  }

  /// The days kept of the program `id` names, newest first, seven at most; empty for one the
  /// device does not know.
  days: async func(device: borrow<device>, id: string) -> list<day>;
}
