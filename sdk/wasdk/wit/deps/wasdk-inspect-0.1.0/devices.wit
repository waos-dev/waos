package wasdk:inspect@0.1.0;

/// The devices whose WaOS can be inspected, and the programs on each: this device, and each phone
/// or computer WaOS reaches now.
interface devices {
  /// A program on a device, installed or run in development.
  record program {
    id: string,
    /// As its user knows it: its package's name, or its id for a development run of a program
    /// not installed.
    name: string,
    /// Its package's version; none for a development run of a program not installed.
    version: option<string>,
    /// Whether it runs now.
    running: bool,
  }

  /// A change to the programs on a device, each by its id but one installed.
  variant program-change {
    /// A program installed.
    added(program),
    /// A program removed.
    removed(string),
    /// A program that started running.
    started(string),
    /// A program that ended.
    ended(string),
  }

  resource device {
    /// Its name, as its user knows it.
    name: func() -> string;
    /// Whether it is the device this program runs on.
    is-this-device: func() -> bool;
    programs: async func() -> list<program>;
    /// Each change from now on, on a stream of its own.
    program-changes: func() -> stream<program-change>;
    /// The icon of the program `id` names, as its package's PNG; none for one without an icon,
    /// as a development run of a program not installed. Asked for as a program is shown, so a
    /// list of many stays small.
    icon: async func(id: string) -> option<list<u8>>;
  }

  /// A device reached or lost, by its name: `devices` answers it once reached.
  variant device-change {
    reached(string),
    lost(string),
  }

  /// This device first, then each device reached now.
  devices: func() -> list<device>;
  device-changes: func() -> stream<device-change>;
}

/// What an inspector imports: every interface of this package, which a program has only once its
/// user granted it the inspector role.
world inspection {
  import devices;
  import audit;
  import active-uses;
  import trace;
}
