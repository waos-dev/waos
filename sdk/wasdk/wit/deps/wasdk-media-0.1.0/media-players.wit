package wasdk:media@0.1.0;

/// Media played by the system's own player: a file or a stream, its sound played and its picture
/// drawn by the system, as Android's and Windows' `MediaPlayer`, Apple's `AVPlayer` and the web's
/// media element play both.
///
/// **Sources.** A player is opened on a path the program can read, inside the program as its files
/// are reached (`std::fs`), or on an `http` or `https` link, which the system's player fetches
/// itself. A link passes the program's network rules first, as its own requests do: the network
/// switch and its rule of domains, its host looked up first, so the local-network switch applies to
/// a host on this computer or the local network. A source the rules refuse, a path outside the
/// program's files, and text that is neither give a player that failed, and the system is handed
/// none of them.
///
/// **State.** A player loads by itself, and tells through its state what the system's player does,
/// not what the program asked of it: how far it got, whether it is paused, waiting or playing and
/// why, as the system pauses a player itself (a call takes the sound, headphones are unplugged), a
/// seek under way until it lands, what is loaded and where it can seek, the rate, volume and mute
/// it plays with, which the system can change, how long its media is, the size of its picture and
/// its media's tracks, and a failure with its kind, whenever it comes: `state` reads it, and
/// `state-changes` hears it again at each change. Its position is read when the program needs it
/// (`position`), as every system's player lets it be read; it moves on by itself while the player
/// plays, and nothing is sent on a timer.
///
/// **Tracks and subtitles.** A player plays one audio track and shows one text track or none,
/// picked by their ids in its state's `tracks`. The system draws no subtitles: a player hands the
/// program the cues of the text track it shows, to draw over the picture (`cue-changes`), as the
/// media styles them, each style the media leaves unsaid none; the user's caption style is a
/// setting of the system's own, which the program merges in as it draws. What the media's tags say
/// is its `metadata`.
///
/// **Picture.** A player's picture goes to one destination at a time, which the program makes and
/// gives it (`video-frames`): a composition layer of the system's compositor (`views`), which the
/// system draws the video on, shown beneath the program's drawing while its view's layers name
/// it; or a frame reader, whose frames the program draws itself. A player given none plays its
/// sound alone.
interface media-players {
  use wasi:clocks/types@0.3.0.{duration};
  use wasdk:platform/windows@0.1.0.{size};
  use video-frames.{video-output};

  resource media-players {
    /// A player of `source`: a path the program can read, or a link, which passes the
    /// program's network rules first. It loads by itself; its state tells how far it got.
    open: func(source: string) -> media-player;
  }

  /// The system's players, where it has them.
  get-media-players: func() -> option<media-players>;

  /// One player, which stops as it is dropped, its picture leaving where it went.
  resource media-player {
    /// Where the picture goes, one destination at a time; none for no picture.
    set-video-output: func(output: option<video-output>);
    /// Plays from where it is, at the rate set last: from the start once it has ended.
    play: func();
    pause: func();
    /// Moves to `position`, or as near it as `tolerance` lets the system land for speed, playing
    /// on from there if it was playing. Its state tells the seek under way until it lands; a seek
    /// outside the seekable ranges moves nothing.
    seek: func(position: duration, tolerance: seek-tolerance);
    /// How fast it plays, 1.0 the media's own speed; kept while paused, for the next play.
    set-rate: func(rate: f64);
    /// How loud it plays, from 0.0, silent, to 1.0, the media's own volume.
    set-volume: func(volume: f32);
    /// Whether its sound is off, apart from its volume.
    set-muted: func(muted: bool);
    /// Whether it starts again from the beginning when it reaches the end, rather than ending.
    set-looping: func(looping: bool);
    state: func() -> player-state;
    /// Where it is in the media now; the target while a seek is under way.
    position: func() -> duration;
    /// The state again each time it changes, and each time the position jumps, as a seek landing
    /// or a loop makes it: a stream read late hears the newest, passing over those between. Each
    /// call is a stream of its own, which ends with the player.
    state-changes: func() -> stream<player-state>;
    /// Plays the audio track `id` in place of the one playing.
    select-audio-track: func(id: string);
    /// Turns the text track `id` on, or none: subtitles off. Its cues arrive on `cue-changes`.
    select-text-track: func(id: option<string>);
    /// The cues to show now, again each time they change; empty while no text track is on. A
    /// stream read late hears the newest. Each call is a stream of its own, which ends with the
    /// player.
    cue-changes: func() -> stream<list<cue>>;
    /// What the media says about itself; empty until it is ready.
    metadata: func() -> media-metadata;
    /// The metadata again each time it changes, such as a live stream's current title. A stream
    /// read late hears the newest. Each call is a stream of its own, which ends with the player.
    metadata-changes: func() -> stream<media-metadata>;
  }

  record player-state {
    status: player-status,
    /// Whether it is paused, waiting or playing, as the system reports it.
    activity: player-activity,
    /// Where a seek is taking it, until it lands; none while no seek is under way. A later seek
    /// replaces the target.
    seeking: option<duration>,
    /// The rate it plays at while it plays, 1.0 the media's own speed, kept while paused for the
    /// next play; as the system reports it, which can differ from the rate asked for.
    rate: f64,
    /// How loud it plays, from 0.0 to 1.0.
    volume: f32,
    /// Whether its sound is off, apart from its volume.
    muted: bool,
    /// None until known, and for a live stream.
    duration: option<duration>,
    /// The parts of the media loaded now, in order.
    loaded: list<time-range>,
    /// The parts it can seek into, in order: the whole media for a file, a moving window for a
    /// live stream, none where it cannot seek.
    seekable: list<time-range>,
    /// The picture's size, in its own pixels, as it is presented; none until known, and for
    /// media without one.
    size: option<size>,
    /// The media's tracks; empty until it is ready.
    tracks: list<media-track>,
  }

  variant player-status {
    loading,
    ready,
    /// It cannot play, from the start or partway through, and does nothing more; it is opened
    /// again to try again.
    failed(player-error),
  }

  /// What a player is doing: Apple's `timeControlStatus`, Windows' `PlaybackState`.
  variant player-activity {
    /// Not playing, and not trying to; none where the system does not say why.
    paused(option<pause-reason>),
    /// Trying to play, and waiting; none where the system does not say why.
    waiting(option<wait-reason>),
    playing,
  }

  enum pause-reason {
    /// The program paused it, or has not played it yet.
    requested,
    /// It reached the end of media it does not loop.
    end,
    /// The system took the sound for something else: a call, another app.
    interrupted,
    /// The sound's output went, such as headphones unplugged.
    output-removed,
    /// The app went to the background, where the system pauses its video.
    backgrounded,
  }

  enum wait-reason {
    /// For media data.
    data,
    /// The system judges whether data comes fast enough to play on, and Apple advises showing no
    /// waiting yet.
    evaluating-data,
    /// The system holds it back for a moment, as during Android's short loss of audio focus.
    held-by-system,
  }

  record player-error {
    kind: player-error-kind,
    /// The system's own words, for logs: not for showing as they are.
    message: string,
  }

  /// The kind of a failure, which a program words for its user and acts on: the web's
  /// `MediaError` and Windows' `MediaPlayerError` share the first three, and Apple's and Media3's
  /// errors fall into them.
  enum player-error-kind {
    /// Reaching the media failed: a connection, a timeout, an HTTP error, a file not there.
    network,
    /// The media is damaged, or decoding it failed.
    decode,
    /// A format or codec the system cannot play.
    unsupported,
    /// The media is protected, and the system may not play it here.
    protected,
    /// The player may not reach the source: the program's network rules refused the link, the
    /// path is outside the program's files, or the system does not let it read or fetch it.
    refused,
    /// Anything else the system reports.
    other,
  }

  /// A span of a player's media.
  record time-range {
    start: duration,
    end: duration,
  }

  /// How far from its target a seek may land, before and after it, for the system to land
  /// sooner: Apple's tolerances, Media3's seek parameters. Both 0 for an exact seek; the largest
  /// duration on a side for no bound there, as for the nearest keyframe. A system that seeks only
  /// exactly keeps any tolerance.
  record seek-tolerance {
    before: duration,
    after: duration,
  }

  record media-track {
    /// Names the track for this player's run.
    id: string,
    kind: media-track-kind,
    /// A BCP 47 language tag; empty where the media gives none.
    language: string,
    /// Its name as the media gives it; empty where it gives none.
    label: string,
    /// Whether it plays now: one audio track at a time, and one text track or none.
    selected: bool,
  }

  enum media-track-kind {
    audio,
    video,
    text,
  }

  /// What the media says about itself, from its tags; a field is none where it does not say.
  record media-metadata {
    title: option<string>,
    artist: option<string>,
    album: option<string>,
    /// The cover image, encoded as the media holds it.
    artwork: option<encoded-image>,
  }

  record encoded-image {
    mime-type: string,
    data: list<u8>,
  }

  /// One subtitle or caption to show: Media3's `Cue`, field for field, as the media styles it.
  record cue {
    content: cue-content,
    /// Where its box sits from the top: a fraction of the picture's height, or a line number;
    /// none for the default, the bottom.
    line: option<cue-line>,
    line-anchor: cue-anchor,
    /// Where its box sits across, as a fraction of the picture's width; none for the default,
    /// the centre.
    position: option<f32>,
    position-anchor: cue-anchor,
    /// Its box's width as a fraction of the picture's; none to fit what it holds.
    size: option<f32>,
    text-alignment: cue-text-alignment,
    vertical: option<cue-vertical>,
    /// The colour of the box behind it; none where the media says none.
    window-color: option<color>,
  }

  variant cue-content {
    /// Its text, in runs of one style.
    text(list<cue-text-run>),
    /// A picture subtitle, as Blu-ray, DVD and DVB carry them, decoded.
    image(cue-image),
  }

  /// A run of a cue's text in one style; each style is none where the media says none.
  record cue-text-run {
    text: string,
    bold: bool,
    italic: bool,
    underline: bool,
    color: option<color>,
    /// The colour behind these characters.
    background: option<color>,
    /// The text's height as a fraction of the picture's.
    font-size: option<f32>,
    font-family: option<string>,
    edge: option<cue-text-edge>,
    edge-color: option<color>,
  }

  record cue-image {
    width: u32,
    height: u32,
    /// RGBA, 8 bits a channel, rows from the top.
    pixels: list<u8>,
    /// Its height on screen as a fraction of the picture's; its width is the cue's `size`.
    display-height: f32,
  }

  variant cue-line {
    fraction(f32),
    number(s32),
  }

  enum cue-anchor {
    start,
    middle,
    end,
  }

  enum cue-text-alignment {
    start,
    center,
    end,
  }

  enum cue-vertical {
    right-to-left,
    left-to-right,
  }

  enum cue-text-edge {
    none,
    outline,
    drop-shadow,
    raised,
    depressed,
  }

  /// 0xAARRGGBB.
  type color = u32;
}
