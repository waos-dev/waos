package wasdk:media@0.1.0;

/// The user's caption settings: how the system's settings say subtitles and captions are to look,
/// beside the cues a player hands out as the media styles them (`media-players`). Apple's
/// `MACaptionAppearance`, Android's `CaptioningManager` and Windows' `ClosedCaptionProperties`
/// keep them; Linux and the web keep none. Reading them asks the user nothing.
///
/// Each setting says whether it applies always, over what the media says, or only where the media
/// says nothing, as Apple's settings do; the program merges the style into each cue as it draws
/// it, as Media3's `SubtitleView` and the web's cue style sheets do.
interface caption-settings {
  use media-players.{color, cue-text-edge};

  /// The user's caption settings, where the system keeps them.
  get-caption-settings: func() -> option<caption-settings>;

  resource caption-settings {
    /// The style the user set.
    style: func() -> caption-style;
    /// The style again each time the user changes it: a stream read late hears the newest. Each
    /// call is a stream of its own.
    style-changes: func() -> stream<caption-style>;
  }

  /// What the user set for captions; each setting is none where the system gives no value for
  /// it.
  record caption-style {
    /// The text's colour, opaque.
    foreground-color: option<color-setting>,
    /// The text's opacity, from 0.0 to 1.0.
    foreground-opacity: option<number-setting>,
    /// The colour behind each character, opaque.
    background-color: option<color-setting>,
    background-opacity: option<number-setting>,
    /// The colour of the box behind a whole cue, opaque.
    window-color: option<color-setting>,
    window-opacity: option<number-setting>,
    /// How much the box's corners are rounded, in logical pixels.
    window-corner-radius: option<number-setting>,
    /// What is drawn round the characters.
    edge: option<edge-setting>,
    /// The edge's colour, with its opacity.
    edge-color: option<color-setting>,
    typeface: option<typeface-setting>,
    /// How many times its own size the text is drawn at.
    text-scale: option<number-setting>,
  }

  record color-setting {
    value: color,
    behavior: caption-behavior,
  }

  record number-setting {
    value: f64,
    behavior: caption-behavior,
  }

  record edge-setting {
    value: cue-text-edge,
    behavior: caption-behavior,
  }

  record typeface-setting {
    value: caption-typeface,
    behavior: caption-behavior,
  }

  /// When a setting applies: Apple's `MACaptionAppearanceBehavior`.
  enum caption-behavior {
    /// Over what the media says.
    always,
    /// Only where the media says nothing.
    where-media-says-nothing,
  }

  /// The font captions are drawn in.
  variant caption-typeface {
    /// A family by name.
    family(string),
    /// A kind of font, as caption standards name them and Windows gives the user's choice.
    generic(generic-caption-font),
  }

  enum generic-caption-font {
    monospaced-with-serifs,
    proportional-with-serifs,
    monospaced-without-serifs,
    proportional-without-serifs,
    casual,
    cursive,
    small-capitals,
  }
}
